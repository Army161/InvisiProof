{
  "expo": {
    "name": "InvisiProof",
    "slug": "invisiproof",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/app-icon-aoa.png",
    "splash": {
      "image": "./assets/images/app-icon-aoa.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1220"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon-aoa.png",
        "backgroundColor": "#0B1220"
      },
      "package": "com.northstarrevenue.proofloopverify",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/images/app-icon-aoa.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow InvisiProof to select screenshots or photos you choose to review.",
          "cameraPermission": "Allow InvisiProof to take a photo of suspicious content you choose to review.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "invisiproof",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "RC_ANDROID_KEY": "test_wngvWkiIcSyCEwteDNyeCpbfVSX"
    }
  }
}